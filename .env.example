# 环境变量示例: 复制为 .env 或直接在终端 export / $env: 设置
# 注意: 本项目的脚本读取的是【进程环境变量】, 不会自动加载 .env 文件,
#       请用 setx / export / $env:VAR=... 的方式设置。

# ---- 必填: 多模态大模型 ----
# Responses API 与 chat/completions 都支持, 会自动降级
LLM_API_KEY=
# 中转站或官方地址, 默认 https://sub.fancybag.cn/v1
LLM_BASE_URL=
# 需要支持图片输入的多模态模型, 默认 gpt-6-luna
LLM_MODEL=
# responses | chat, 留空默认 responses(不支持时自动降级)
LLM_API_STYLE=

# ---- 登录用手机号(不要提交真实号码到仓库) ----
LOGIN_PHONE=
